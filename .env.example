# pcb-ai-agent environment variables
#
# Copy to .env and adjust values.  Never commit .env (already in .gitignore).
# All variables are optional — the package uses sane defaults.

# Ollama endpoint (used by the ReAct agent and the LLM judge).
# Inside the Docker network use the compose service name:  http://ollama:11434
# On the host machine:                                      http://localhost:11434
OLLAMA_HOST=http://ollama:11434

# Ollama model name for the agent and the optional LLM judge.
OLLAMA_MODEL=qwen2.5-coder:7b

# Set to 1 to run the real-Ollama integration tests (pytest -m llm).
# Requires a running Ollama server reachable at OLLAMA_HOST.
PCB_AGENT_RUN_LLM=0
