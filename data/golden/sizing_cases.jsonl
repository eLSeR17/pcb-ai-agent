{"case_id": "sizing_led_5v_2v_20ma", "description": "Series resistor for a red LED driven from a 5 V rail at 20 mA", "function": "led_series_resistor", "inputs": {"v_supply": 5.0, "v_led": 2.0, "i_led": 0.02}, "expected": [150.0, 0.06], "why": "R=(V_supply-V_led)/I_led=(5-2)/0.02=150 -> E12 step 150; P=I^2*R=0.02^2*150=0.06 W"}
{"case_id": "sizing_led_3v3_1v9_10ma", "description": "Series resistor for a 1.9 V LED on a 3.3 V rail at 10 mA", "function": "led_series_resistor", "inputs": {"v_supply": 3.3, "v_led": 1.9, "i_led": 0.01}, "expected": [150.0, 0.015], "why": "R=(3.3-1.9)/0.01=140 -> nearest E12 step is 150; P=0.01^2*150=0.015 W"}
